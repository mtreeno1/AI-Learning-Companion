# AI Learning Companion - Environment Variables
# Copy this file to .env and update with your values

# ===========================================
# Database Configuration
# ===========================================
DB_USER=aicompanion
DB_PASSWORD=changeme123_please_use_strong_password
DB_NAME=ai_learning_companion
DB_HOST=db
DB_PORT=5432

# Full database URL (auto-constructed in docker-compose)
# DATABASE_URL=postgresql://aicompanion:password@db:5432/ai_learning_companion

# ===========================================
# API Configuration
# ===========================================
API_HOST=0.0.0.0
API_PORT=8000

# Secret key for JWT (CHANGE THIS IN PRODUCTION!)
SECRET_KEY=your-super-secret-key-change-this-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ===========================================
# CORS Configuration
# ===========================================
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost,https://yourdomain.com

# ===========================================
# Frontend Configuration
# ===========================================
# Backend API URL (for client-side requests)
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# ===========================================
# Port Configuration
# ===========================================
BACKEND_PORT=8000
FRONTEND_PORT=3000

# ===========================================
# Video Recording Configuration
# ===========================================
RECORDINGS_PATH=recordings
RECORDING_DEFAULT_FPS=30.0
RECORDING_DEFAULT_RESOLUTION=1920x1080
RECORDING_DEFAULT_CODEC=mp4v
RECORDING_RETENTION_DAYS=7

# ===========================================
# Cloud Storage (Optional)
# ===========================================
ENABLE_CLOUD_STORAGE=false

# AWS S3 Configuration
S3_BUCKET_NAME=your-bucket-name
S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key

# Azure Blob Storage (Alternative)
# AZURE_STORAGE_CONNECTION_STRING=your-connection-string
# AZURE_CONTAINER_NAME=recordings

# Google Cloud Storage (Alternative)
# GCS_BUCKET_NAME=your-bucket-name
# GCS_CREDENTIALS_PATH=/path/to/credentials.json

# ===========================================
# AI Model Configuration
# ===========================================
# YOLO model paths (relative to ai-engine directory)
YOLO_DET_MODEL=models/yolov8n.pt
YOLO_POSE_MODEL=models/yolov8n-pose.pt

# Detection confidence threshold
DETECTION_CONFIDENCE=0.5

# ===========================================
# Email Configuration (Optional - for notifications)
# ===========================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=noreply@yourdomain.com

# ===========================================
# Monitoring & Logging (Optional)
# ===========================================
LOG_LEVEL=INFO
SENTRY_DSN=

# ===========================================
# Production Settings
# ===========================================
# Set to true for production
PRODUCTION=false

# Domain name (for SSL)
DOMAIN=yourdomain.com

# Let's Encrypt email (for SSL certificates)
LETSENCRYPT_EMAIL=admin@yourdomain.com

# ===========================================
# Performance Tuning
# ===========================================
# Number of worker processes (backend)
WORKERS=4

# Max upload size (in MB)
MAX_UPLOAD_SIZE=100

# Session timeout (in seconds)
SESSION_TIMEOUT=3600

# ===========================================
# Rate Limiting
# ===========================================
RATE_LIMIT_PER_MINUTE=60

# ===========================================
# Notes
# ===========================================
# 1. Never commit .env file to git
# 2. Use strong passwords in production
# 3. Change SECRET_KEY to a random string
# 4. Update CORS_ORIGINS with your domain
# 5. Enable HTTPS in production
# 6. Configure firewall rules
# 7. Setup regular database backups
